{
  "name": "@helpmath/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:generated && npm run build:executive-runtime && next build && npm run check:public-client-boundaries && npm run check:private-demo-traces && npm run check:private-demo-leaks",
    "build:executive-runtime": "node scripts/build-executive-demo-runtime.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:launch-gates && npm run check:demo-lifecycle && npm run build:executive-runtime && tsx --test tests/**/*.test.ts && npm run test:release-smoke && npm run check:legacy-source-custody",
    "test:release-smoke": "node --test tests/release-smoke-helpers.test.mjs",
    "test:legacy-apache": "npm run check:legacy-apache && tsx --test tests/apache-legacy-generator.test.ts tests/legacy-apache.contract.ts",
    "preflight:legacy-cutover": "node --import tsx scripts/legacy-cutover-preflight-bootstrap.mjs",
    "check:legacy-source-custody": "node scripts/validate-legacy-source-custody.mjs --require-successful",
    "verify:legacy-source-archive": "node scripts/verify-legacy-source-archive.mjs",
    "build:legacy-source-recovery": "node scripts/build-legacy-source-recovery-bundle.mjs",
    "drill:legacy-source-recovery": "node scripts/drill-legacy-source-recovery.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox-smoke",
    "test:e2e:mobile-webkit": "playwright test --project=mobile-webkit-smoke",
    "test:e2e:webkit": "playwright test --project=webkit-smoke",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:coverage": "npm run test:coverage:aggregate && npm run test:coverage:launch-gates-v3",
    "test:coverage:aggregate": "tsx --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=75 --test-coverage-exclude=lib/launch-gate-lifecycle-v3.ts --test-coverage-exclude=scripts/validate-launch-gates.ts --test-coverage-exclude=scripts/validate-launch-gate-transition.ts tests/**/*.test.ts tests/**/*.test.mjs",
    "test:coverage:launch-gates-v3": "tsx --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=55 tests/launch-gate-evidence-v3.test.ts tests/launch-gate-lifecycle-v3.test.ts tests/launch-gate-transition-script.test.ts tests/validate-launch-gates-v3-script.test.ts",
    "smoke:production": "node scripts/release-smoke.mjs",
    "smoke:executive-preview": "tsx scripts/executive-preview-operator-check.ts",
    "generate:demos": "npm run check:demo-lifecycle && tsx scripts/generate-registry.mjs",
    "generate:legacy-apache": "tsx scripts/generate-apache-legacy-redirects.ts",
    "check:generated": "npm run check:launch-gates && npm run check:demo-lifecycle && tsx scripts/generate-registry.mjs --check && npm run check:legacy-apache",
    "check:demo-lifecycle": "tsx scripts/validate-demo-lifecycle.ts",
    "check:launch-gates": "tsx scripts/validate-launch-gates.ts",
    "check:launch-gate-transition": "tsx scripts/validate-launch-gate-transition.ts",
    "check:legacy-apache": "tsx scripts/generate-apache-legacy-redirects.ts --check",
    "check:public-client-boundaries": "node scripts/check-public-client-boundaries.mjs",
    "check:private-demo-leaks": "tsx scripts/check-private-demo-leaks.mjs",
    "check:private-demo-traces": "node scripts/verify-private-demo-traces.mjs",
    "check:stable-links": "node scripts/check-stable-external-links.mjs",
    "test:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@marsidev/react-turnstile": "^1.5.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
