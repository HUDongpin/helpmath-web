{
  "name": "@helpmath/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:launch-gates && npm run build:executive-runtime && next build && npm run check:private-demo-traces && npm run check:private-demo-leaks",
    "build:executive-runtime": "node scripts/build-executive-demo-runtime.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:launch-gates && npm run build:executive-runtime && tsx --test tests/**/*.test.ts && npm run test:release-smoke && npm run check:legacy-source-custody",
    "test:release-smoke": "node --test tests/release-smoke-helpers.test.mjs",
    "test:legacy-apache": "npm run check:legacy-apache && tsx --test tests/apache-legacy-generator.test.ts tests/legacy-apache.contract.ts",
    "preflight:legacy-cutover": "tsx scripts/legacy-cutover-preflight.ts",
    "check:legacy-source-custody": "node scripts/validate-legacy-source-custody.mjs --require-successful",
    "verify:legacy-source-archive": "node scripts/verify-legacy-source-archive.mjs",
    "build:legacy-source-recovery": "node scripts/build-legacy-source-recovery-bundle.mjs",
    "drill:legacy-source-recovery": "node scripts/drill-legacy-source-recovery.mjs",
    "test:e2e": "playwright test",
    "smoke:production": "node scripts/release-smoke.mjs",
    "generate:demos": "node scripts/generate-registry.mjs",
    "generate:legacy-apache": "tsx scripts/generate-apache-legacy-redirects.ts",
    "check:generated": "npm run check:launch-gates && npm run generate:demos && git diff --exit-code -- demos/registry.generated.ts && npm run check:legacy-apache",
    "check:launch-gates": "tsx scripts/validate-launch-gates.ts",
    "check:legacy-apache": "tsx scripts/generate-apache-legacy-redirects.ts --check",
    "check:private-demo-leaks": "node scripts/check-private-demo-leaks.mjs",
    "check:private-demo-traces": "node scripts/verify-private-demo-traces.mjs",
    "check:stable-links": "node scripts/check-stable-external-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@marsidev/react-turnstile": "^1.5.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
